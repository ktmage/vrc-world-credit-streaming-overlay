{
  "name": "vrc-world-credit-streaming-overlay",
  "module": "src/server.ts",
  "dependencies": {
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"bun run dev:client\" \"bun run dev:server\"",
    "dev:client": "bun build ./client/index.html --outdir ./dist/client --watch",
    "dev:server": "bun --watch ./src/server.ts",
    "build": "bun build ./client/index.html --outdir ./dist/client --minify",
    "start": "bun ./src/server.ts"
  },
  "type": "module"
}
